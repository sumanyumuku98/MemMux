<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MemMux daemon as a macOS user LaunchAgent.
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl load` it.
     Adjust the memmuxd path if you installed somewhere other than ~/.local/bin. -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.memmux.memmuxd</string>
    <key>ProgramArguments</key>
    <array>
      <string>memmuxd</string>
      <string>serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/memmuxd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/memmuxd.err.log</string>
  </dict>
</plist>
